{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "java-limiter",
  "compatibility_date": "2026-10-01",
  // Pure static documentation: Workers Static Assets serves the VitePress build output,
  // there is no Worker script and no /api/* backend, so the site costs no request quota.
  "assets": {
    "directory": "./.vitepress/dist",
    "not_found_handling": "404-page"
  },
  // 域名绑定不在仓库里声明：统一在 Cloudflare Dashboard 的
  // Worker → Settings → Domains & Routes 维护。
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
